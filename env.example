# Copy these into Railway > your service > Variables (never commit real values).

# --- required ---
ADMIN_PASSWORD=choose_a_long_password
NODE_ENV=production
# Makes sure Railway builds with a Node version this site supports (22.13 or newer)
RAILPACK_NODE_VERSION=22
# Your public address, e.g. https://your-app.up.railway.app
BASE_URL=https://your-app.up.railway.app

# --- Continue with Google + emails sent from your Gmail (Gmail API, works on Railway) ---
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
# Optional: defaults to BASE_URL + /auth/google/callback
# GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/auth/google/callback
GOOGLE_REFRESH_TOKEN=your_refresh_token_with_gmail.send_scope
EMAIL_FROM=donryscott28@gmail.com

# --- AI assistant: set ONE of these ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override
# AI_MODEL=

# --- Other email options if you skip Google: RESEND_API_KEY + MAIL_FROM, or BREVO_API_KEY + MAIL_FROM ---
